# Copy to .env.local. Both are optional.

# Damian's judgement. Without this he still walks the site and reports what the
# DOM pass can measure. With it, every captured screen goes to a vision model
# that decides what is worth saying, and the measurements become the only
# figures he is allowed to quote.
ANTHROPIC_API_KEY=

# Where Chrome lives, if it is not on one of the usual paths.
CHROME_PATH=
